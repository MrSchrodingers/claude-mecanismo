{
  "id": "node-analyzer",
  "ecosystem": "node",
  "operation_class": "parse",
  "detect": ["package.json", "tsconfig.json"],
  "extensions": [".js", ".mjs", ".cjs"],
  "exec": { "command": "node", "args": ["--check"] },
  "per_file": true,
  "declared_effects": { "executes_repository_code": false, "writes_repository": false, "network": false },
  "rationale": "`node --check` faz parsing sintatico e sai antes de executar o modulo. NAO cobre .ts: tsc carrega tsconfig e plugins do repo, o que e execucao.",
  "limits": { "timeout_seconds": 60 },
  "test": { "command": "npm", "args": ["test"], "executes_repository_code": true }
}

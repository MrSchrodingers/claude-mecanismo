diff --git a/install/apply-claude-global.ps1 b/install/apply-claude-global.ps1
new file mode 100644
index 0000000..94d626c
--- /dev/null
+++ b/install/apply-claude-global.ps1
@@ -0,0 +1,60 @@
+[CmdletBinding()]
+param(
+    [switch]$DryRun,
+    [switch]$Verify
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+$Repo = Split-Path -Parent $PSScriptRoot
+$Apply = Join-Path $Repo 'install/apply.sh'
+$VerifyScript = Join-Path $Repo 'install/verify.sh'
+
+function Resolve-GitBash {
+    $Candidates = @(
+        $env:CLAUDE_CODE_GIT_BASH_PATH,
+        (Join-Path $env:ProgramFiles 'Git\bin\bash.exe'),
+        (Join-Path $env:ProgramFiles 'Git\usr\bin\bash.exe'),
+        (Join-Path ${env:ProgramFiles(x86)} 'Git\bin\bash.exe')
+    ) | Where-Object { $_ }
+
+    $Command = Get-Command bash.exe -ErrorAction SilentlyContinue
+    if ($Command) {
+        $Candidates = @($Command.Source) + $Candidates
+    }
+
+    foreach ($Candidate in $Candidates) {
+        if (Test-Path -LiteralPath $Candidate -PathType Leaf) {
+            return (Resolve-Path -LiteralPath $Candidate).Path
+        }
+    }
+
+    throw 'Git Bash não encontrado. Instale Git for Windows ou defina CLAUDE_CODE_GIT_BASH_PATH.'
+}
+
+function Convert-ToBashPath([string]$WindowsPath, [string]$Bash) {
+    $Result = & $Bash -lc "cygpath -u '$($WindowsPath.Replace("'", "'\"'\"'"))'"
+    if ($LASTEXITCODE -ne 0 -or -not $Result) {
+        throw "Não foi possível converter o caminho: $WindowsPath"
+    }
+    return $Result.Trim()
+}
+
+$Bash = Resolve-GitBash
+$ApplyBash = Convert-ToBashPath $Apply $Bash
+$VerifyBash = Convert-ToBashPath $VerifyScript $Bash
+
+if ($Verify) {
+    & $Bash $VerifyBash
+} elseif ($DryRun) {
+    & $Bash $ApplyBash '--dry-run'
+} else {
+    & $Bash $ApplyBash
+}
+
+if ($LASTEXITCODE -ne 0) {
+    throw "evidence-gate terminou com código $LASTEXITCODE."
+}
+
+Write-Host "Configuração global verificada em $env:USERPROFILE\.claude"

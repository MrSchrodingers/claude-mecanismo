avaliacao.md` para o contrato de evidência.
+"""
+
+
+def graph_markdown(workflows: list[dict[str, Any]]) -> str:
+    lines = [
+        "# Grafos de workflow gerados",
+        "",
+        "NAO EDITAR. Gerado por `orchestration/render.py` a partir de `orchestration/workflows/`.",
+        "",
+    ]
+    for workflow in workflows:
+        node_by_id = {node["id"]: node for node in workflow["nodes"]}
+        lines.extend([f"## `{workflow['id']}`", "", workflow["description"], "", "```mermaid", "flowchart TD"])
+        for node in workflow["nodes"]:
+            label = node["id"]
+            if node.get("agent"):
+                label += f"\n{node['agent']}"
+            if node.get("state"):
+                label += f"\n{node['state']}"
+            shape_left, shape_right = ("[[", "]]" ) if node["kind"] == "terminal" else ("[", "]")
+            lines.append(f"    {node['id']}{shape_left}{label}{shape_right}")
+        for source, target in workflow["edges"]:
+            lines.append(f"    {source} --> {target}")
+        if workflow.get("correction_edge"):
+            source, target = workflow["correction_edge"]
+            lines.append(f"    {source} -. correção limitada .-> {target}")
+        lines.extend(["```", "", "| Nó | Tipo | Agente | Escrita | Paralelo |", "|---|---|---|:---:|---|"])
+        for node in workflow["nodes"]:
+            lines.append(
+                f"| `{node['id']}` | {node['kind']} | {node.get('agent', '—')} | "
+                f"{'sim' if node.get('writes') else 'não'} | {node.get('parallel_group', '—')} |"
+            )
+        lines.append("")
+        # Referenciar node_by_id evita que grafos com arestas órfãs sejam renderizados silenciosamente.
+        for source, target in workflow["edges"]:
+            if source not in node_by_id or target not in node_by_id:
+                raise ProjectionError(f"aresta órfã em {workflow['id']}: {source}->{target}")
+    return "\n".join(lines).rstrip() + "\n"
+
+
+def build_projection() -> tuple[dict[str, bytes], set[str]]:
+    registry = load_registry()
+    workflows = load_workflows()
+    expected: dict[str, bytes] = {}
+    executable: set[str] = set()
+
+    agents = registry["agents"]
+    for name, spec in sorted(agents.items()):
+        source = ROOT / spec["source"]
+        metadata, body = parse_agent(source)
+        if metadata.get("name") != name:
+            raise ProjectionError(f"nome do registry diverge do frontmatter: {name}")
+        expected[f".claude/agents/{name}.md"] = source.read_bytes()
+        toml = "\n".join(
+            [
+                f"name = {json.dumps(name, ensure_ascii=False)}",
+                f"description = {json.dumps(str(metadata.get('description', '')), ensure_ascii=False)}",
+                f"model = {json.dumps(spec['codex_model'])}",
+                f"model_reasoning_effort = {json.dumps(spec['effort'])}",
+                f"sandbox_mode = {json.dumps('workspace-write' if spec['writes'] else 'read-only')}",
+                f"developer_instructions = {json.dumps(body, ensure_ascii=False)}",
+                "",
+            ]
+        )
+        expected[f".codex/agents/{name}.toml"] = toml.encode()
+
+    skills_root = ROOT / registry["skills_root"]
+    for source in sorted(path for path in skills_root.rglob("*") if path.is_file()):
+        relative = source.relative_to(skills_root)
+        content = source.read_bytes()
+        expected[str(Path(".claude/skills") / relative)] = content
+        expected[str(Path(".agents/skills") / relative)] = content
+
+    for name, source in sorted(hook_sources().items()):
+        content = source.read_bytes()
+        for prefix in (".claude/hooks", ".codex/hooks"):
+            path = str(Path(prefix) / name)
+            expected[path] = content
+            executable.add(path)
+
+    hooks = canonical_hooks()
+    expected[".claude/settings.json"] = json_text(
+        {
+            "env": {
+                "EVIDENCE_GATE_REPO": "${CLAUDE_PROJECT_DIR}",
+                "CLAUDE_ADAPTERS_DIR": "${CLAUDE_PROJECT_DIR}/execution/adapters/code",
+                "DOC_ADAPTERS_DIR": "${CLAUDE_PROJECT_DIR}/execution/adapters/documents",
+            },
+            "hooks": hooks,
+        }
+    ).encode()
+
+    expected[".codex/config.toml"] = (
+        "# Gerado por orchestration/render.py; não editar.\n"
+        "[features]\n"
+        "hooks = true\n\n"
+        "[agents]\n"
+        "enabled = true\n"
+        f"max_concurrent_threads_per_session = {registry['invariants']['read_parallelism_cap']}\n"
+        'default_subagent_model = "gpt-5.6"\n'
+        'default_subagent_reasoning_effort = "high"\n'
+    ).encode()
+    expected[".codex/hooks.json"] = json_text(codex_hooks(hooks)).encode()
+    expected[".codex/run-hook.py"] = codex_runner().encode()
+    executable.add(".codex/run-hook.py")
+
+    expected["CLAUDE.md"] = claude_instructions(registry, workflows).encode()
+    expected["AGENTS.md"] = codex_instructions(registry, workflows).encode()
+    expected["docs/architecture/workflow-graphs.generated.md"] = graph_markdown(workflows).encode()
+    graph_payload = {
+        "schema_version": 1,
+        "registry": "orchestration/registry.json",
+        "workflows": [{key: value for key, value in workflow.items() if key != "_source"} for workflow in workflows],
+    }
+    expected["evidence/graphs/workflows.generated.json"] = json_text(graph_payload).encode()
+    return expected, executable
+
+
+def managed_existing_paths() -> set[str]:
+    paths: set[str] = set()
+    for singleton in MANAGED_SINGLETONS:
+        if (ROOT / singleton).exists():
+            paths.add(singleton)
+    for prefix in MANAGED_PREFIXES:
+        directory = ROOT / prefix
+        if directory.exists():
+            paths.update(str(path.relative_to(ROOT)) for path in directory.rglob("*") if path.is_file())
+    return paths
+
+
+def check_projection(expected: dict[str, bytes], executable: set[str]) -> list[str]:
+    errors: list[str] = []
+    actual = managed_existing_paths()
+    for extra in sorted(actual - set(expected)):
+        errors.append(f"arquivo extra: {extra}")
+    for path, content in sorted(expected.items()):
+        target = ROOT / path
+        if not target.is_file():
+            errors.append(f"arquivo ausente: {path}")
+            continue
+        if target.read_bytes() != content:
+            errors.append(f"conteúdo divergente: {path}")
+        actual_exec = bool(target.stat().st_mode & 0o111)
+        expected_exec = path in executable
+        if actual_exec != expected_exec:
+            errors.append(f"modo executável divergente: {path}")
+    return errors
+
+
+def write_projection(expected: dict[str, bytes], executable: set[str]) -> None:
+    stale = managed_existing_paths() - set(expected)
+    for path in sorted(stale, reverse=True):
+        (ROOT / path).unlink()
+    for path, content in sorted(expected.items()):
+        target = ROOT / path
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(content)
+        target.chmod(0o755 if path in executable else 0o644)
+    for prefix in MANAGED_PREFIXES:
+        directory = ROOT / prefix
+        if directory.exists():
+            for child in sorted(directory.rglob("*"), reverse=True):
+                if child.is_dir() and not any(child.iterdir()):
+                    child.rmdir()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--check", action="store_true", help="não escreve; reprova por drift")
+    args = parser.parse_args()
+    try:
+        expected, executable = build_projection()
+        if args.check:
+            errors = check_projection(expected, executable)
+            if errors:
+                for error in errors:
+                    print(f"PROJECTION_ERROR {error}")
+                return 1
+            print(f"projeções atualizadas: {len(expected)} arquivos")
+            return 0
+        write_projection(expected, executable)
+        errors = check_projection(expected, executable)
+        if errors:
+            raise ProjectionError("; ".join(errors))
+        print(f"projeções geradas: {len(expected)} arquivos")
+        return 0
+    except (OSError, ValueError, json.JSONDecodeError, yaml.YAMLError, ProjectionError) as exc:
+        print(f"renderização falhou: {exc}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

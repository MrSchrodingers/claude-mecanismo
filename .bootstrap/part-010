@@ -0,0 +1,471 @@
+#!/usr/bin/env python3
+"""Renderiza projeções Claude Code e Codex a partir do núcleo canônico.
+
+Uso:
+    python3 orchestration/render.py
+    python3 orchestration/render.py --check
+
+A execução normal converge as projeções. ``--check`` não escreve: reprova por
+conteúdo, arquivo extra ou modo executável divergente.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+from typing import Any
+
+import yaml
+
+ROOT = Path(__file__).resolve().parents[1]
+REGISTRY_PATH = ROOT / "orchestration/registry.json"
+WORKFLOWS_DIR = ROOT / "orchestration/workflows"
+MANIFEST_PATH = ROOT / "install/manifest.lock"
+
+MANAGED_PREFIXES = (
+    ".claude/agents/",
+    ".claude/skills/",
+    ".claude/hooks/",
+    ".codex/agents/",
+    ".codex/hooks/",
+    ".agents/skills/",
+)
+MANAGED_SINGLETONS = {
+    ".claude/settings.json",
+    ".codex/config.toml",
+    ".codex/hooks.json",
+    ".codex/run-hook.py",
+    "CLAUDE.md",
+    "AGENTS.md",
+    "docs/architecture/workflow-graphs.generated.md",
+    "evidence/graphs/workflows.generated.json",
+}
+
+
+class ProjectionError(RuntimeError):
+    """Erro de contrato do núcleo ou de uma projeção."""
+
+
+def read_text(path: Path) -> str:
+    return path.read_text(encoding="utf-8")
+
+
+def json_text(value: Any) -> str:
+    return json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n"
+
+
+def parse_agent(path: Path) -> tuple[dict[str, Any], str]:
+    text = read_text(path)
+    match = re.match(r"\A---\n(.*?)\n---\n(.*)\Z", text, flags=re.DOTALL)
+    if not match:
+        raise ProjectionError(f"frontmatter ausente ou inválido: {path.relative_to(ROOT)}")
+    metadata = yaml.safe_load(match.group(1))
+    if not isinstance(metadata, dict):
+        raise ProjectionError(f"frontmatter não é objeto: {path.relative_to(ROOT)}")
+    return metadata, match.group(2).rstrip() + "\n"
+
+
+def load_registry() -> dict[str, Any]:
+    registry = json.loads(read_text(REGISTRY_PATH))
+    if registry.get("schema_version") != 1:
+        raise ProjectionError("schema_version do registry não suportado")
+    return registry
+
+
+def load_workflows() -> list[dict[str, Any]]:
+    workflows = []
+    for path in sorted(WORKFLOWS_DIR.glob("*.json")):
+        workflow = json.loads(read_text(path))
+        workflow["_source"] = str(path.relative_to(ROOT))
+        workflows.append(workflow)
+    if not workflows:
+        raise ProjectionError("nenhum workflow canônico encontrado")
+    return workflows
+
+
+def hook_sources() -> dict[str, Path]:
+    sources: dict[str, Path] = {}
+    for raw in read_text(MANIFEST_PATH).splitlines():
+        if not raw or raw.startswith("#"):
+            continue
+        kind, source, destination, _digest = raw.split("\t")
+        if kind != "hook":
+            continue
+        name = Path(destination).name
+        path = ROOT / source
+        if name in sources:
+            raise ProjectionError(f"hook duplicado no manifesto: {name}")
+        if not path.is_file():
+            raise ProjectionError(f"hook do manifesto ausente: {source}")
+        sources[name] = path
+    if not sources:
+        raise ProjectionError("manifesto não contém hooks")
+    return sources
+
+
+def canonical_hooks() -> dict[str, Any]:
+    proc = subprocess.run(
+        ["bash", "install/hooks-spec.sh", "${CLAUDE_PROJECT_DIR}/.claude/hooks"],
+        cwd=ROOT,
+        text=True,
+        capture_output=True,
+        check=False,
+    )
+    if proc.returncode != 0:
+        raise ProjectionError(f"hooks-spec falhou: {proc.stderr.strip()}")
+    hooks = json.loads(proc.stdout)
+    for groups in hooks.values():
+        for group in groups:
+            for handler in group.get("hooks", []):
+                command = handler.get("command", "")
+                match = re.fullmatch(r"bash (.+)", command)
+                if not match:
+                    raise ProjectionError(f"comando de hook fora do contrato: {command!r}")
+                handler["command"] = "bash"
+                handler["args"] = [match.group(1)]
+    return hooks
+
+
+def codex_hooks(claude_hooks: dict[str, Any]) -> dict[str, Any]:
+    supported = {
+        "SessionStart",
+        "PreToolUse",
+        "PostToolUse",
+        "UserPromptSubmit",
+        "Stop",
+        "SubagentStop",
+        "SubagentStart",
+    }
+    result: dict[str, Any] = {}
+    for event, groups in claude_hooks.items():
+        if event not in supported:
+            continue
+        rendered_groups = []
+        for group in groups:
+            rendered = {key: value for key, value in group.items() if key != "hooks"}
+            rendered_handlers = []
+            for handler in group.get("hooks", []):
+                script = Path(handler["args"][0]).name
+                item: dict[str, Any] = {
+                    "type": "command",
+                    "command": (
+                        'python3 "$(git rev-parse --show-toplevel)/.codex/run-hook.py" '
+                        + script
+                    ),
+                    "commandWindows": (
+                        "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "
+                        '"$r=(git rev-parse --show-toplevel); '
+                        f"py -3 (Join-Path $r '.codex/run-hook.py') '{script}'\""
+                    ),
+                }
+                if "timeout" in handler:
+                    item["timeout"] = handler["timeout"]
+                rendered_handlers.append(item)
+            rendered["hooks"] = rendered_handlers
+            rendered_groups.append(rendered)
+        result[event] = rendered_groups
+    return {
+        "description": "Projeção gerada do núcleo canônico do evidence-gate; não editar diretamente.",
+        "hooks": result,
+    }
+
+
+def codex_runner() -> str:
+    return '''#!/usr/bin/env python3
+"""Executa um hook Bash do projeto de modo estável em Unix e Windows."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+
+def find_bash() -> str:
+    candidates = [
+        os.environ.get("CLAUDE_CODE_GIT_BASH_PATH"),
+        shutil.which("bash"),
+        r"C:\Program Files\Git\bin\bash.exe",
+        r"C:\Program Files\Git\usr\bin\bash.exe",
+    ]
+    for candidate in candidates:
+        if candidate and Path(candidate).is_file():
+            return str(candidate)
+    raise SystemExit("Git Bash/bash não encontrado; configure CLAUDE_CODE_GIT_BASH_PATH")
+
+
+def main() -> int:
+    if len(sys.argv) != 2 or Path(sys.argv[1]).name != sys.argv[1]:
+        print("uso: run-hook.py <nome-do-hook.sh>", file=sys.stderr)
+        return 2
+    root = Path(__file__).resolve().parents[1]
+    script = root / ".codex" / "hooks" / sys.argv[1]
+    if not script.is_file() or script.is_symlink():
+        print(f"hook ausente ou inválido: {script}", file=sys.stderr)
+        return 2
+    return subprocess.run([find_bash(), str(script)], cwd=Path.cwd()).returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
+'''
+
+
+def claude_instructions(registry: dict[str, Any], workflows: list[dict[str, Any]]) -> str:
+    ids = ", ".join(workflow["id"] for workflow in workflows)
+    return f"""# evidence-gate — contrato de execução para Claude Code
+
+Este arquivo é gerado por `orchestration/render.py`; a fonte normativa é
+`orchestration/registry.json` e `orchestration/workflows/*.json`.
+
+## Estado e autoridade
+
+- A sessão termina, no máximo, em `CANDIDATE`; somente o check remoto
+  `{registry['invariants']['external_certifier']}` ligado ao SHA pode autorizar merge.
+- Agentes de leitura podem trabalhar em paralelo, até
+  {registry['invariants']['read_parallelism_cap']} threads; escrita é serializada.
+- `tdd` e `implementador` escrevem em worktree isolada. Autor não certifica a própria mudança.
+- Revisão e refutação recebem o artefato cru e resultados executados, não apenas o resumo do autor.
+- Lacuna de ferramenta, plataforma ou pré-condição é `NOT_VERIFIED`, nunca sucesso.
+- O ciclo de correção é limitado a {registry['invariants']['correction_round_cap']} rodadas.
+
+## Seleção de workflow
+
+Workflows canônicos: {ids}.
+
+- Use `investigation-only` para parecer sem escrita.
+- Use `standard-change` para mudança não trivial comum.
+- Use `high-risk-change` para autorização, entrada não confiável, dependências,
+  instalação privilegiada, supply chain ou trust boundary.
+
+Consulte `docs/architecture/workflow-graphs.generated.md` para o grafo exato e
+`docs/architecture/orquestracao-multirruntime.md` para os limites da arquitetura.
+"""
+
+
+def codex_instructions(registry: dict[str, Any], workflows: list[dict[str, Any]]) -> str:
+    ids = ", ".join(workflow["id"] for workflow in workflows)
+    return f"""# evidence-gate — instruções de projeto para Codex
+
+Fonte normativa: `orchestration/registry.json` e `orchestration/workflows/*.json`.
+As projeções sob `.codex/`, `.agents/` e este arquivo são geradas; não editar manualmente.
+
+## Acordos operacionais
+
+- Estado terminal local: `{registry['invariants']['terminal_state']}`. Certificação é externa,
+  pelo check `{registry['invariants']['external_certifier']}` vinculado ao SHA.
+- No máximo {registry['invariants']['read_parallelism_cap']} subagentes de leitura em paralelo.
+- Nunca execute dois agentes escritores no mesmo workspace. Use escrita serializada e
+  worktree/branch isolada quando houver alteração concorrente.
+- `tdd` produz o experimento RED; `implementador` materializa a menor correção; ambos são
+  avaliados por agentes read-only distintos.
+- Ausência de dependência, plataforma ou tratamento exercitável é `NOT_VERIFIED`, não PASS.
+- No máximo {registry['invariants']['correction_round_cap']} ciclos sem nova evidência.
+- Não faça merge com base em autoavaliação. O agente entrega um candidato.
+
+## Workflows disponíveis
+
+{ids}
